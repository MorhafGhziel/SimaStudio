# Copy to .env.local (local) and add the same keys in Vercel → Project → Settings → Environment Variables.

# Neon Postgres connection string (Vercel → Storage → Neon, free plan). Stores visits + admin logins.
DATABASE_URL=

# Random secret, 32+ characters. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=

# Resend API key (free plan) — contact form, admin login codes and login alerts.
RESEND_API_KEY=
CONTACT_TO=simastudio7@gmail.com
CONTACT_FROM=SIMA Website <onboarding@resend.dev>
# Sender for admin emails. Must be on a domain verified in Resend to reach both admin inboxes.
AUTH_FROM=SIMA Admin <admin@your-verified-domain.com>
